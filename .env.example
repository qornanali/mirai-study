# Remote seed manifest URL (GitHub raw URL recommended)
# Used by the "Check seed updates" action in Settings to fetch the latest seed manifest.
# The manifest must point to a valid seed-manifest.json produced by `npm run seed:emit`.
#
# Example (replace with your repo path):
# VITE_SEED_MANIFEST_URL=https://raw.githubusercontent.com/<owner>/<repo>/main/seeds/v2026-04-09/seed-manifest.json
VITE_SEED_MANIFEST_URL=
